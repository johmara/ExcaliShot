[Desktop Entry]
Type=Application
Name=ExcaliShot
Comment=Screenshots with Excalidraw annotation
Exec=excalishot-app
Icon=excalishot-app
Terminal=false
Categories=Utility;Graphics;
# The window announces itself by the binary name, so that is what GNOME must match to find this
# file's icon. (The file name, se.johmara.excalishot, is the app ID the portals use.)
StartupWMClass=excalishot-app
