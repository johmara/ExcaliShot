{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExcaliShot",
  "mainBinaryName": "excalishot-app",
  "version": "0.1.0",
  "identifier": "se.johmara.excalishot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ExcaliShot",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Johan Martinson",
    "copyright": "Copyright (c) 2026 Johan Martinson",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Screenshots with Excalidraw annotation",
    "longDescription": "Capture a region, a monitor or all monitors, sketch on it with Excalidraw, then copy or save it.",
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/linux/desktop.template",
        "files": {
          "/usr/share/applications/se.johmara.excalishot.desktop": "../packaging/linux/se.johmara.excalishot.desktop"
        }
      },
      "rpm": {
        "desktopTemplate": "../packaging/linux/desktop.template",
        "files": {
          "/usr/share/applications/se.johmara.excalishot.desktop": "../packaging/linux/se.johmara.excalishot.desktop"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
